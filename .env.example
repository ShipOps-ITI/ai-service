AI_FALLBACK_MODELS=
# Keep chat responsive. Values are milliseconds, tokens, and milliseconds.
AI_PROVIDER_TIMEOUT_MS=12000
AI_MAX_TOKENS=350
AI_TOOL_CACHE_TTL_MS=20000
FRONTEND_ORIGIN=http://localhost:5173
SHIPMENT_SERVICE_URL=http://localhost:5004/api/shipments
CORE_SERVICE_URL=http://localhost:5002/api/v1
